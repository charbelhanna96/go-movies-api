# APP
PORT=8080
APP_SHUTDOWN_TIMEOUT_SEC=15

# LOGGING
LOG_LEVEL=info

# POSTGRESQL
DATABASE_NAME=movie
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME_MIN=5
DATABASE_CONN_MAX_IDLE_TIME_MIN=1

# HTTP CONFIG
ALLOWED_ORIGINS=http://localhost:3000
HTTP_READ_TIMEOUT_SEC=10
HTTP_WRITE_TIMEOUT_SEC=10
HTTP_IDLE_TIMEOUT_SEC=60

# HEALTH HANDLER
HEALTH_HANDLER_TIMEOUT_SEC=2

# MOVIES HANDLER
MOVIES_HANDLER_TIMEOUT_SEC=5

# OBSERVABILITY
OTEL_ENDPOINT=jaeger:4318
